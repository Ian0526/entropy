# Copy to .env for local runs. On Railway, set these as service variables instead.

# auto | lfdr | qrngapi | anu | anu-legacy | none
# auto = lfdr: OTH Regensburg LfD QRNG (ID Quantique Quantis PCIe), keyless, polled every 2 min.
# Keyed providers below are only used when named explicitly.
QRNG_PROVIDER=auto

# qrngapi.com (keys start with qnrk_). Free tier: 10 KB/month = 10 requests of 1024 bytes.
QRNGAPI_KEY=
# auto | photon | ... (see GET https://qrngapi.com/api/methods)
QRNGAPI_METHOD=auto

# ANU Quantum Numbers (https://quantumnumbers.anu.edu.au). Trial: 100 requests/month.
ANU_API_KEY=

# Ingest batches the provider labels "simulator" (shown as SIMULATED, never as quantum). Default: reject.
QRNG_ACCEPT_SIMULATOR=0
# Overrides (default: spread the provider's monthly allowance evenly over the month)
# QRNG_MONTHLY_REQUESTS=10
# QRNG_INTERVAL_MS=259200000

# Site password (whole site) and Builder. Set these as Railway service variables.
# SITE_PASSWORD=
# SITE_SESSION_SECRET=
# BUILDER_WORKER_TOKEN=

# Builder worker on your PC (npm run builder / builder:full)
# BUILDER_URL=https://<your-app>.up.railway.app
# BUILDER_WORKER_TOKEN=
